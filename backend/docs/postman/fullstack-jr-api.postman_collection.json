              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Solo para bases vacias sin usuarios previos."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json && json.accessToken) {",
                  "  pm.collectionVariables.set('adminAccessToken', json.accessToken);",
                  "}",
                  "if (json && json.refreshToken) {",
                  "  pm.collectionVariables.set('adminRefreshToken', json.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
